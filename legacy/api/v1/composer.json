{
    "name": "mpm/api",
    "description": "My Payroll Master API Services",
    "keywords": ["microframework", "rest", "router", "psr7"],
    "homepage": "http://github.com/slimphp/Slim-Skeleton",
    "license": "MIT",
    "authors": [
        {
            "name": "MPM",
            "email": "info@mypayrollmaster.com",
            "homepage": "https://mypayrollmaster.com/mypayrollmaster/"
        }
    ],
    "require": {
        "php": ">=5.5.0",
        "slim/slim": "^3.1",
        "slim/php-view": "^2.0",
        "monolog/monolog": "^1.17"
    },
    "require-dev": {
        "phpunit/phpunit": ">=4.8 < 6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        },
        "files": [
            "src/App/Controller/ClientdbController.php",
            "src/App/Controller/ApiController.php",
            "src/App/Controller/SecurityController.php"
        ]
    }

}