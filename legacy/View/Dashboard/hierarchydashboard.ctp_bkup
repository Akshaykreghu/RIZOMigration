$(document).ready(function () {

var interval = setInterval( function () {
    $.ajax({
                                url:livesite+ 'Dashboard/Timers',
                                success: function(resp){
                                    
                                    $('#settimer').val($.parseJSON(resp).set);
                                    if($.parseJSON(resp).run == 1)
                                    //alert($('#settimer').val());
                                        {
                                            startTimer();
                                        }
                                        else
                                        {
                                            FixedTimer();
                                        }
                                    
                                }
                            });
        //startTimer();
        clearInterval(interval);
    }, 6000 );
    
