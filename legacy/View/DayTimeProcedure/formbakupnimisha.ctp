    function weekShow(s){
        var elem = $(s).attr('id');
        //alert(elem);
        if ($(s).is(":checked")) {
            showweekdays(elem);
        }else{
            pullweek(elem);
        }
    }
    function toggleExceptions(s){
        $('#exceptionss').toggleClass('Exceptionshow');
        if ($(s).is(":checked")) {
            $('.disabled').attr("disabled",false);
        }else{
            $('.disabled').attr("disabled",true);
        }
    }
    function half_weekShow(s){
        var el = $(s).attr('id').toString();
        var elem = $('#'+el+'day').attr('id');
        //alert(elem);
        if ($(s).is(":checked")) {
            pullweek(elem);
        }else{
            showweekdays(elem);
        }
    }
    function showweekdays(s){
        //alert(Week);
        Week.push(s);
        addweeks();
    }
    function pullweek(s){
        const index = Week.indexOf(s);
        Week.splice(index, 1);
        addweeks();
    } 
    function addweeks(){
        //alert(Week);
        $('#filterby_branch').html('');
        $.each(Week, function(i, value) {
            $('#filterby_branch').append($('<option>').text(value).attr('value', value));
        });
    }
    function toggleDisable(me, togggleId) {
        
        if ($(me).is(":checked")) {
            $("#" + togggleId).show().attr("disabled",false);
            $('#ot').show();
        } else {
            $("#" + togggleId).hide();
            $("#" + togggleId).show().attr("disabled",true);
