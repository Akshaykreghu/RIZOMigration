    function calculateWorkTimeOne(start, end, result) {
        var start = $('#' + start).val();
        var end = $('#' + end).val();
        if (end && start) {
            var date = new Date();
            var hr_mm_ampm_start = start.split(":");
            var hr_mm_ampm_end = end.split(":");
            var Start_min = date.setMinutes(hr_mm_ampm_start[1].substr(0, 2));
            var Start_hr = date.setHours(hr_mm_ampm_start[0]);
            var end_time = new Date();
            if ($('#next_day').prop("checked") == true)
            {
                //dt += 14400;
                end_time.setDate(end_time.getDate() + 1);
            }
            end_time.setMinutes(hr_mm_ampm_end[1].substr(0, 2));
            end_time.setHours(hr_mm_ampm_end[0]);
            //alert(date);

            //alert(end_time);
            var dt = end_time.getTime() - date.getTime();

            var durations = dt / 60000;
            $('#' + result).val(durations);
            console.log(durations)
        }
    }

    function calculateWorkTimeTwo() {
        var start = $('#' + start).val();
        var end = $('#' + end).val();
        var hr_mm_ampm_start = start.split(":");
        var hr_start = hr_mm_ampm_start[0];
        var mm_start = hr_mm_ampm_start[1].substr(0, 2);
        var ampm_start = hr_mm_ampm_start[1].substr(2);

        if ((ampm_start == "AM" || ampm_start == "am") && hr_start == 12) {
            hr_start = 0;
        }
        if ((ampm_start == "PM" || ampm_start == "pm") && hr_start != 12) {
            hr_start = parseInt(hr_start) + 12;
        }
        //	console.log(hr_start);
        ///	console.log(mm_start)
        //	console.log(ampm_start)
        var totalTime1 = hr_start * 60 + parseInt(mm_start);
        totalTime1 = totalTime1 + parseInt(mm_start);
        //console.log(totalTime1)
        var hr_mm_ampm_end = end.split(":");
        var hr_end = hr_mm_ampm_end[0];
        var mm_end = hr_mm_ampm_end[1].substr(0, 2);
        var ampm_end = hr_mm_ampm_end[1].substr(2);
        if ((ampm_end == "AM" || ampm_end == "am") && hr_start == 12) {
            hr_end = 0;
        }
        if ((ampm_end == "PM" || ampm_end == "pm") && hr_start != 12) {
            hr_end = parseInt(hr_end) + 12;
        }
        //console.log(hr_end);
        //console.log(mm_end)
        //console.log(ampm_end)
        //var hr_diff = hr_end-hr_start;
        //var hr_diff = hr_end-hr_start;
        var totalTime2 = hr_end * 60 + parseInt(mm_end);
        if ($('#next_day').prop("checked") == true)
        {
            var totalTime2 = 1440 + totalTime2;
        }
        $('#' + result).val(totalTime2 - totalTime1);
        console.log(totalTime2)
    }

