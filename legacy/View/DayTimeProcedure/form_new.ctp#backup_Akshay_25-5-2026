    function calculateMaxInTime() {
    // Get DOM elements
    var offDutyEl = document.getElementById('off_dutty1'); 
    var maxMinutesEl = document.getElementById('maxinmin');
    var maxInEl = document.getElementById('maxintime_input');

    if (!offDutyEl || !maxMinutesEl || !maxInEl) return;

    var offDuty = offDutyEl.value; // e.g., "18:30" or "18:30:00"
    var extraMin = parseInt(maxMinutesEl.value) || 0;

    if (offDuty) {
        // Split into parts
        var parts = offDuty.split(':');
        var hours = parseInt(parts[0]) || 0;
        var minutes = parseInt(parts[1]) || 0;
