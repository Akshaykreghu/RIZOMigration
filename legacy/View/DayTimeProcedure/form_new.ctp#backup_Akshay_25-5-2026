$('#spForm').submit(function(e) {
    e.preventDefault();

    // ✅ Simple HTML5 validation check
    if (!this.checkValidity()) {
        // Trigger built-in browser validation message
        this.reportValidity();
        return false;
    }

    $.ajax({
        url: $(this).attr('action'),
        type: 'POST',
        data: $(this).serialize(),
        dataType: 'json',
        success: function(response) {
            if (response.status === 'success') {
                $('#shiftModal').modal('hide');
                alert(response.msg);
                refreshShiftGrid();
            } else {
                alert(response.msg || 'Failed to save shift.');
            }
        },
        error: function(xhr, status, error) {
            console.error(xhr.responseText);
            alert('Error saving shift. Please try again.');
        }
    });
});

