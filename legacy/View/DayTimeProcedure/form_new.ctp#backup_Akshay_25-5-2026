function checkExceptionEligibility() {

    var inTime  = document.getElementById("on_dutty1").value;
    var outTime = document.getElementById("off_dutty1").value;
    var exceptionSwitch = document.getElementById("someSwitchOptionSuccess2");

    if (!inTime || !outTime) {
        exceptionSwitch.checked = false;
        exceptionSwitch.disabled = true;
        return;
    }

    // Convert HH:MM:SS to seconds
    function timeToSeconds(time) {
        var parts = time.split(":");
        var hours = parseInt(parts[0]) || 0;
        var mins  = parseInt(parts[1]) || 0;
        var secs  = parseInt(parts[2]) || 0;
        return (hours * 3600) + (mins * 60) + secs;
    }

    var inSeconds  = timeToSeconds(inTime);
    var outSeconds = timeToSeconds(outTime);

    var diff = outSeconds - inSeconds;

    // Enable only if strictly greater than 1 hour
    if (diff > 3600) {
        exceptionSwitch.disabled = false;
    } else {
        exceptionSwitch.checked = false;
        exceptionSwitch.disabled = true;
    }
}

