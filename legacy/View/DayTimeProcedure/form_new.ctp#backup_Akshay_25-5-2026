   function calculateWorkTimeOne(start, end, result) {
    var startVal = $('#' + start).val();
    var endVal = $('#' + end).val();

    if (startVal && endVal) {
        // --- Parse Start Time ---
        var startParts = startVal.split(":");
        var dateStart = new Date();
        dateStart.setHours(parseInt(startParts[0], 10));
        dateStart.setMinutes(parseInt(startParts[1] || 0));
        dateStart.setSeconds(0);

        // --- Parse End Time ---
        var endParts = endVal.split(":");
        var dateEnd = new Date();
        dateEnd.setHours(parseInt(endParts[0], 10));
        dateEnd.setMinutes(parseInt(endParts[1] || 0));
        dateEnd.setSeconds(0);

       
       // --- Duration Calculation ---
var dt = dateEnd.getTime() - dateStart.getTime();

// ✅ If next day checkbox is checked, always add 1 day
if ($('#next_day').prop('checked')) {
    dateEnd.setDate(dateEnd.getDate() + 1);
    dt = dateEnd.getTime() - dateStart.getTime();
}
// ❗ Else only add next day if out < in naturally (cross midnight)
else if (dt < 0) {
    dateEnd.setDate(dateEnd.getDate() + 1);
    dt = dateEnd.getTime() - dateStart.getTime();
}

var duration = Math.round(dt / 60000);
$('#' + result).val(duration);


        // --- Handle Max Out Time (only when next_day checked) ---
        if ($('#next_day').prop('checked')) {
            $('#extraminutes').show();
            $('#maxouttime').show();

            var extraMin = parseInt($('#extra_minutes').val() || 0, 10);
            if (extraMin > 1440) extraMin = 1440;

            // Add extra minutes to end time
            var dateMax = new Date(dateEnd.getTime() + extraMin * 60000);

            var hh = String(dateMax.getHours()).padStart(2, '0');
            var mm = String(dateMax.getMinutes()).padStart(2, '0');
            var ss = String(dateMax.getSeconds()).padStart(2, '0');

            $('#maxtime').val(`${hh}:${mm}:${ss}`);
        } else {
            $('#extraminutes').hide();
            $('#maxouttime').hide();
            $('#extra_minutes').val('');
            $('#maxtime').val('');
        }
    } else {
        $('#extraminutes').hide();
        $('#maxouttime').hide();
    }

    // --- Trigger dependent checks ---
    if ($('#off_dutty2').val() != '0:00:00') {
        checktimings1();
    } else {
        checktimings();
    }
}

