<script>
    // Function to update row counts in the first column
    function updateRowCount() {
        $('#inputTable tbody tr').each(function(index) {
            $(this).find('td:first').text(index + 1);
        });
    }

    function toggleTableDivVisibility() {
        var rowCount = $('#inputTable tbody tr').length;
        console.log('rowCount', rowCount);
        $('#tableDiv').toggle(rowCount > 0);
    }

    function btnIssue() {
        // Flag to check if all fields have values
        var allFieldsFilled = true;

        // Iterate through each input field within the form
        $("#uploadForm input[type='text'], #uploadForm select").each(function() {
            // Check if the field has a value
            $('input, select').each(function() {
                // Check if the field is not disabled
                if (!$(this).is(':disabled')) {
                    // Check if the field is empty
                    if ($(this).val() === "") {
                        emptyField = $(this).attr('id') || $(this).attr('name');
                        if (emptyField !== 'searchqupo') {
                            allFieldsFilled = false;
                            console.log('emptyField', emptyField);
                            return false; // Stop the iteration if any non-disabled field is empty
                        }
                    }
                }
            });
        });

        var rowCount = $('#inputTable tbody tr').length;
        if (rowCount <= 0) {
            $.notify("No item to submit.", {
                type: 'danger',
                allow_dismiss: false,
                className: 'notify-container',
                z_index: 9999
            });
        } else {
            // Display a message based on whether all fields are filled
            if (allFieldsFilled) {
                // Add any additional actions you want to perform when all fields are filled

                var confirmation = confirm("Are you sure you want to submit the form?");

                if (confirmation) {
                    // Collect form data
                    var pkey = <?php echo json_encode($pkey); ?>;
                    var formData = $("#uploadForm").serialize();

                    // Perform AJAX request
                    $.ajax({
                        url: "<?php echo $this->webroot; ?>GatePass/savePass/" + pkey,
                        type: "POST",
                        data: formData,
                        success: function(response) {
                            // Handle the response from the server
                            $.notify('Form submitted successfully!', {
                                type: 'success',
                                allow_dismiss: false,
                                className: 'notify-container',
                                z_index: 9999
                            });

                            var passPkey = response.pkey

                            // Simulate loading delay
                            $('.loading-overlay').show();
                            setTimeout(function() {
                                // Hide loading overlay after a delay (simulating content loading)
                                $('.loading-overlay').hide();
                            }, 2000);

                            showLargeModalForm(livesite + 'GatePass/savePreview/' + passPkey);

                            //$("#largeModalForm").modal("hide");



                        },
                        error: function(xhr, status, error) {
                            // Handle errors
                            // console.error(xhr.responseText);
                            $.notify('Error submitting the form. Please try again.', {
                                type: 'danger',
                                allow_dismiss: false,
                                className: 'notify-container',
                                z_index: 9999
                            });
                            $("#largeModalForm").modal("hide");
                        }
                    });
                } else {
                    // $("#largeModalForm").modal("hide");
                }
                $('#documents_manager').datagrid('reload');
            } else {
                // alert("Please fill the required fields.");
                $.notify("Please fill the required fields.", {
                    type: 'danger',
                    allow_dismiss: false,
                    className: 'notify-container',
                    z_index: 9999
                });
            }
        }

    }

    $('#type').select2();
    $('#req_person').select2();
    //$('#issued_to').select2();
    $('#issued_by').select2();
    $('#sanctioned_by').select2();

    function updateReturnDateState() {
        console.log('Gate pass', $('#type').val());
        if ($('#type').val() === 'Material Gate Pass - Return') {
            $('.return_date').prop('disabled', false);
        } else {
            $('.return_date').prop('disabled', true);
        }
    }


    //Amount
    function updateAmount(input) {
        // Get the row containing the input field
        var row = input.closest('tr');

        // Find the related input fields and amount element within the same row
        var qtyInput = row.querySelector('.qty');
        var rateInput = row.querySelector('.rate');
        var amountInput = row.querySelector('.amount');

        // Get the values of qty and rate
        var qty = parseFloat(qtyInput.value) || 0;
        var rate = parseFloat(rateInput.value) || 0;

        // Calculate the product of qty and rate
        var amount = qty * rate;
        console.log('Amount', amount);
        // Update the amount field in the same row
        amountInput.value = amount.toFixed(2);
    }

    // Function to handle row deletion
    function deleteRow(btn) {
        var row = btn.closest('tr');
        row.remove();
        updateRowCount();
        toggleTableVisibility();
    }

    // Function to toggle table visibility based on the number of rows
    function toggleTableVisibility() {
        var rowCount = $('#inputTable tbody tr').length;
        if (rowCount === 0) {
            $('#inputTable').hide();
            $('#tableDiv').hide();
        } else {
            $('#inputTable').show();
            $('#tableDiv').show();
        }
    }

    $(document).ready(function() {

        $('.return_date').datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true
            // You can customize the date format as needed
        });

        if ($('#type').val() === 'Material Gate Pass - Return') {
            $('.return_date').prop('disabled', false);
        } else {
            $('.return_date').prop('disabled', true);
        }

        var currentIssuedDate = $("#issued_date").val();

        var rowCount = rowCount = $('#inputTable tbody tr').length;
        if (rowCount > 0) {
            $('#tableDiv').show();
        } else {
            $('#tableDiv').hide();
        }


        // Set the datepicker with the current value of issued_date as the default value
        $("#issued_date").datepicker({
            format: 'yyyy-mm-dd',
            autoclose: true
        });

        // $(".return_date").datepicker({
        //     format: 'yyyy-mm-dd',
        //     autoclose: true
        // });




        // Add item button click event
        $('#addItemBtn').on('click', function() {
            $('#tableDiv').toggle(true);
            // Clone the first row and append it to the tbody
            var rowCount = $('#inputTable tbody tr').length + 1;
            var unitOptions = ['Meter', 'KG', 'Litre', 'Load', 'Sqft', 'Sheet', 'Coil', 'Set', 'Pair', 'Roll', 'Nos', 'Pkt', 'Pcs', 'Feet', 'Tone', 'Box', 'Bags', 'Ton'];

            // Create the select options based on unitOptions
            var selectOptions = unitOptions.map(function(option) {
                return '<option value="' + option + '">' + option + '</option>';
            }).join('');

            var newRow = $('<tr><td>' + rowCount + '</td>' +
                '<td><input name="item_name[]" maxlength="100" type="text" value="" placeholder=""></td>' +
                '<td><input name="qty[]" class="qty" oninput="updateAmount(this)" type="number" value="" placeholder=""></td>' +
                '<td><select style="width:100px;" name="units[]" class="form-control select3"><option value="">Select--</option>' + selectOptions + '</select></td>' +
                '<td><input name="rate[]" class="rate" oninput="updateAmount(this)" type="number" value="" placeholder=""></td>' +
                '<td><input name="amount[]" class="amount" readonly type="text" value="" placeholder=""></td>' +
                '<td><input name="return[]" class="return_date"  type="text" value="" placeholder="" disabled readonly autocomplete="off" ></td></tr>');



            newRow.find('td:first').text(rowCount);

            // Clear input values in other columns
            newRow.find('td:not(:first) input').val('');

            // Create a delete button for the new row
            var deleteButton = $('<button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>');

            // Add the delete button to the last column of the new row
            newRow.append('<td></td>').find('td:last').append(deleteButton);

            // Toggle table visibility after adding a new row
            toggleTableVisibility();

            console.log('newRow', newRow);

            // Append the new row to the tbody
            $('#inputTable tbody').append(newRow);
            $('.select3').select2();

            // Initialize the date picker for the dynamically added input
            newRow.find('.return_date').datepicker({
                format: 'yyyy-mm-dd',
                autoclose: true
                // You can customize the date format as needed
            });

            if ($('#type').val() === 'Material Gate Pass - Return') {
                $('.return_date').prop('disabled', false);
            } else {
                $('.return_date').prop('disabled', true);
            }

            // Show the table if it was hidden
            $('#inputTable').show();
            $('#tableDiv').show();

            // toggleTableDivVisibility();
        });

        // Initial check and hide the table if there are zero rows
        toggleTableDivVisibility();

        // Initial check and hide the table if there are zero rows
        if ($('#inputTable tbody tr').length === 0) {
            $('#inputTable').hide();
        }

        // Handle change in Gate Pass Type select
        $('#type').on('change', function() {
            var isReturnable = $(this).val() === 'Material Gate Pass - Returnable';

            // Set readonly attribute for the 7th column textarea in all rows
            $('#inputTable tbody tr').find('td:nth-child(7) textarea').prop('readonly', !isReturnable);
            // Clear value if not returnable
            if (!isReturnable) {
                $('#inputTable tbody tr').find('td:nth-child(7) textarea').val('');
            }
        });




        $("#cancelButton").click(function() {
            // Hide the modal when the Cancel button is clicked
            $("#largeModalForm").modal("hide");
        });
    });
</script>