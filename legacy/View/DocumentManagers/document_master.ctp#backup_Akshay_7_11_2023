            // Function to load the PDF preview by sending a document key to the controller
            function loadPDFPreview(pdfPath) {
    var url = '/DocumentManager/documentPreview';

    // Make an AJAX request to the server to fetch the PDF content
    $.ajax({
        url: url,
        method: 'POST',
        data: { pdfPath: pdfPath },
        success: function (response) {
            var responseObject = JSON.parse(response);
            if (responseObject && responseObject.status === 'success') {
                var binaryPDF = atob(responseObject.pdfData); // Decode from Base64

                // Convert the binary PDF data to a Blob
                var byteArray = new Uint8Array(binaryPDF.length);
                for (var i = 0; i < binaryPDF.length; i++) {
                    byteArray[i] = binaryPDF.charCodeAt(i);
                }
                var blob = new Blob([byteArray], { type: 'application/pdf' });

                // Create a URL for the Blob object
                var blobURL = window.URL.createObjectURL(blob);

                // Create a new modal to display the PDF content
                var modal = $('<div class="modal"></div>');
                var closeButton = $('<button class="close btn btn-danger">Close</button>');
                var pdfObject = $('<object class="pdf-iframe" data="' + blobURL + '" type="application/pdf"></object>');
                var overlay = $('<div class="overlay"></div>'); // Add an overlay to prevent mouse clicks

                // Add close button, overlay, and PDF object to the modal
                modal.append(pdfObject);
                modal.append(overlay);
                modal.append(closeButton);
                $('body').append(modal);

                // Display the modal with a larger size
                modal.css({
                    'display': 'block',
                    'width': '90%',
                    'height': '90%',
                    'top': '5%',
                    'left': '5%',
                    'padding': '20px',
                    'position': 'fixed',
                    'background-color': '#fff',
                    'border': '1px solid #000',
                    'box-shadow': '5px 5px 15px 5px rgba(0,0,0,0.1)',
                    'z-index': '9999',
                    'overflow': 'auto',
                    'display': 'flex',
                    'flex-direction': 'column',
                    'justify-content': 'center',
                    'align-items': 'center'
                });

                // Adjust the size of the displayed PDF
                pdfObject.css({
                    'width': '100%', // Adjusted width for the PDF object
                    'height': '90%' // Adjusted height for the PDF object
                });

                // Styling for the overlay to prevent mouse clicks
                overlay.css({
                    'position': 'absolute',
                    'top': '0',
                    'left': '0',
                    'width': '96.8%',
                    'height': '88%',
                    'background-color': 'transparent', // Transparent overlay
                    'z-index': '10000', // Higher z-index to cover the PDF
                    'overflow': 'auto' 
                });

                // Styling for the close button
                closeButton.css({
                    'color': '#fff',
                    'font-size': '14px',
                    'font-weight': '100',
                    'cursor': 'pointer',
                    'border': '1px solid #ff0000',
                    'background-color': 'rgba(255, 90, 95, 1)',
                    'padding': '5px 10px',
                    'margin-top': '10px'
                });

                closeButton.hover(
                    function () {
                        $(this).css('background-color', '#ff0000');
                    },
                    function () {
                        $(this).css('background-color', 'rgba(255, 90, 95, 1)');
                    }
                );

                // Event listener to close the modal
                closeButton.on('click', function () {
                    modal.remove();
                });
            } else {
                console.error('Error: The response does not indicate success.');
            }
        },
        error: function (error) {
            console.error('Error: Unable to fetch PDF content', error);
        }
    });
}




