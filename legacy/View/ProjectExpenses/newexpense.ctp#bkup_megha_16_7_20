    function add(){
         var amt = parseFloat($('#expense_amount').val());
         var sgst = parseFloat($('#sgst').val());
         var cgst = parseFloat($('#cgst').val());
         if(amt> 0 && sgst > 0 && cgst > 0){
         var total = amt + sgst + cgst;
         }else if (amt> 0 && cgst > 0){
           var total = amt + cgst; 
         }else if (amt> 0 && sgst > 0){
           var total = amt + sgst; 
         }else if (amt> 0 ){
           var total = amt;  
         }else{
          // var total = 0;   
         }
         total = parseFloat(total);
         $("#total").val(total);
         //$('#payment').max = total;
         // minus();
    }
     function minus(){
     $("#balance").val('');
         var total = parseFloat($('#emp_expenses_total').val());
         var payment = parseFloat($('#payment').val());
       
         if(total> 0 && payment > 0){
         var balance = total - payment;
         }else if(total> 0){
          var balance = total;   
         }
        // balance = parseFloat(balance);
         $("#balance").val(balance);
         
    }
    function requestsubmit(){
        var pid = $("#emp_expenses_pkey").val();
        var total = $("#emp_expenses_total").val();
        var payment = $("#payment").val();
     
