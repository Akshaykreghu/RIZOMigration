<script>
    function sendBack() {
        var form = document.getElementById('assessmentform');

        if (!(form instanceof HTMLFormElement)) {
            $.notify("Form not found.", {
                type: 'error',
                allow_dismiss: false,
            });
            return;
        }

        var formData = new FormData(form);
        formData.set('action_type', 'send_back');

        fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                // Show success or error notification based on the response
                $.notify(result.message, {
                    type: result.status === 'success' ? 'success' : 'danger',
                    allow_dismiss: false,
                });

                if (result.status === 'success') {
                    // ✅ Close modal
                    $('#largeModalForm').modal('hide');

                    // ✅ Refresh datagrid (if the function exists)
                    if (typeof reloadGrid === 'function') {
                        $('#assessment').datagrid('reload');
                    }
                }
            })
            .catch(error => {
                $.notify("Send Back failed. Check console for details.", {
                    type: 'error',
                    allow_dismiss: false,
                    z_index: 9999
                });
                console.error(error);
            });
    }

    function saveDraft() {
        var form = document.getElementById('assessmentform');

        if (!(form instanceof HTMLFormElement)) {
            $.notify("Form not found.", {
                type: 'error',
                allow_dismiss: false,
            });
            return;
        }

        var formData = new FormData(form);
        formData.set('action_type', 'draft'); // Set draft action

        fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                $.notify(result.message, {
                    type: result.status === 'success' ? 'success' : 'danger',
                    allow_dismiss: false,
                });

                if (result.status === 'success') {
                    // ✅ Optional: Close modal
                    $('#largeModalForm').modal('hide');

                    // ✅ Optional: Refresh datagrid
                    if (typeof reloadGrid === 'function') {
                        $('#assessment').datagrid('reload');
                    }
                }
            })
            .catch(error => {
                $.notify("Saving draft failed. Check console for details.", {
                    type: 'error',
                    allow_dismiss: false,
                    z_index: 9999
                });
                console.error(error);
            });
    }





    jQuery(document).ready(function() {

        $('#largeModalForm').modal({
            backdrop: 'static',
            keyboard: false
        });

        var actionType = $('#action_type').val();
        document.querySelectorAll("input[type='number']").forEach(input => {
            // Prevent invalid characters like '-'
            input.addEventListener("keydown", function(e) {
                if (e.key === '-' || e.key === 'e') {
                    e.preventDefault();
                    //alert("Negative values not allowed");
                    $.notify("Negative values not allowed", {
                        type: 'danger',
                        allow_dismiss: false,
                        z_index: 9999
                    });

                }
            });

            // Validate on input
            input.addEventListener("input", function() {
                let value = this.value;

                // Only validate if not empty
                if (value !== '') {
                    let numericValue = value;

                    if (isNaN(numericValue) || numericValue < 0 || numericValue > 5) {
                        //alert("Please enter a value between 0 and 5.");
                        $.notify("Please enter a value between 0 and 5.", {
                            type: 'danger',
                            allow_dismiss: false,
                            z_index: 9999
                        });
                        this.value = '';
                        return;
                    }
                }

                calculateTotalMarks();
            });
        });



        // Function to calculate total marks and grade
        function calculateTotalMarks() {
            let totalMarksRO = 0;
            document.querySelectorAll("input[type='number']").forEach(input => {
                let value = input.value.trim();
                let numericValue = Number(value);

                if (!isNaN(numericValue) && numericValue >= 0 && numericValue <= 5) {
                    totalMarksRO += numericValue;
                }
            });

            // Update total marks in the display
            document.getElementById("totalMarksRO").innerText = totalMarksRO;

            // Calculate grade based on total marks
            let gradeElement = document.getElementById("gradeOutput");
            let grade = " ";
            if (totalMarksRO > 90) {
                grade = "Outstanding";
                gradeElement.style.color = "green";
            } else if (totalMarksRO > 80) {
                grade = "Very Good";
                gradeElement.style.color = "green";
            } else if (totalMarksRO > 60) {
                grade = "Good";
                gradeElement.style.color = "orange";
            } else if (totalMarksRO > 40) {
                grade = "Average";
                gradeElement.style.color = "orange";
            } else {
                grade = "Below Average";
                gradeElement.style.color = "red";
            }

            // Update grade display
            document.getElementById("gradeOutput").innerText = grade;

            // Set hidden inputs for total marks and grade
            $("input[name='total_marks']").val(totalMarksRO);
            $("input[name='grade']").val(grade);
        }


        $("#assessmentform").on("submit", function(e) {
            e.preventDefault(); // Prevent the default form submission

            // Collect form data
            var formData = $(this).serialize();

            // Send data via AJAX
            $.ajax({
                url: "<?php echo $this->webroot; ?>TeamReview/saveRequest", // The action URL
                type: "POST", // Method type (POST)
                data: formData, // The data to send
                dataType: "json", // Expect JSON response
                success: function(response) {
                    if (response.status == 'success') {
                        $.notify(response.message, {
                            type: 'success',
                            allow_dismiss: false,
                        });
                        $('#largeModalForm').modal('hide');
                        $('#assessment').datagrid('reload');
                    }
                },
                error: function(xhr, status, error) {
                    $.notify("Error ocuured while submitting form", {
                        type: 'danger',
                        allow_dismiss: false,
                        z_index: 9999
                    });
                }
            });
        });
    });

    function hideModal() {
        $('#largeModalForm').modal('hide');
    }
</script>