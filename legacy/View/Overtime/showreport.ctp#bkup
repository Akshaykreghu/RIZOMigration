        function viewReport() {
            var selectany = false;
            $('.checkw').each(function() {
                if ($(this).prop('checked') == true) {
                    selectany = true;
                }
            });

            if (selectany) {
                var type = $('#hidden-report-type').val();
                //Edited by Akshay on 2-8-2024
                var skip = false;
                var monthLimit = false;
                if (type == 'OT_MONTHWISE') {
                    var startValue = $('#reportstartfrom').val();
                    var endValue = $('#reportsto').val();
                    var startDate = new Date(startValue + '-01');
                    var endDate = new Date(endValue + '-01');
                    if (startDate > endDate) {
                        skip = true;
                    }
                    if (!skip) {
                        var months;
                        months = (endDate.getFullYear() - startDate.getFullYear()) * 12;
                        months -= startDate.getMonth();
                        months += endDate.getMonth() + 1;
                        monthLimit = (months > 12) ? true : false;
                    }
                }
                if (!skip && !monthLimit) {
                    // Criteria items selected, proceed with report generation
                    $('#loaders').show();
                    var container = $("#reportCon");
                    var url = livesite + 'Overtime/generatereport/' + type;

                    var arrReportFieldsChosen = [];
                    $('#hidden-reportfields').val(arrReportFieldsChosen.join(','));
                    toggleItemsDisplay(1);
                    $('body').addClass('sidebar-collapse');

                    container.load(url, $('#form-showreport').serialize(), function() {
                        $('#loaders').hide();
                        // Show the print button if report type matches
                        if (type === "Overtime_Synthiet" || type == "OT_MONTHWISE") {
                            $('#btn-submit4').show();
                        }
                    });
                } else {
                    if (skip) {
                        alert('To date is not after From date');
                    } else {
                        alert('Limit of 12 months exceeded')
                    }
                }
                //End
            } else {
                alert("Please Choose Criteria items First");
                return false;
            }
        }
