<script>
  
       function close_shift(){
        var site_fkey = $('#filterby_branch').val();
        var day_time_seq_fkey = $('#filterby_shift').val();
        var att_date = $('#filterby_date').val();
        $.ajax({
                    url: livesite + 'SiteAttendance/shift_closure/',
                    method:'POST',
                    data:{site_fkey:site_fkey,day_time_seq_fkey:day_time_seq_fkey,att_date:att_date},
                    success: function (resp) {
                        var response = JSON.parse(resp);
                       // alert(response.message);
                        if(response.success === 0){
                         $.notify(" Can't close shift. Please check out all check in punchings.!",{
                         type: 'danger',
                         allow_dismiss: false
                         });
                         return false;
                        }else{
                         $.notify("Shift closed successfully.",{
                         type: 'success',
                         allow_dismiss: false
                         });
                          $('#shift_close').hide();
                          $('#filterby_shift').val(''); 
                          lod_desig();
                         
                        }
                        
                    }
                });
    }
</script>
