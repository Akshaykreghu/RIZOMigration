<style>
    @keyframes FadeIn {
  from {
    background-color: #7bebbd;
  }
  
  to {
    background-color: white;
  }
}
.block{
    overflow: hidden;
}
.block label{
    display: block;
    float: left;
    margin-bottom: 4px;
    width: 33.333%;
  }
