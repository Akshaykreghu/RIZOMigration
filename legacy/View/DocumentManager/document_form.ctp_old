                                <div class="col-sm-10">
                                    <input class="form-control" placeholder="Please Enter Document Name" type="text" name="document_name" id="document_name" >
                                </div>
                            </div>
                        </div>
                        <div class="form-group form-group-sm">
                            <div class="col-sm-12">
                                <label class="col-sm-2 control-label" >Document Preview<label style="color:red">*</label></label>
                                <div class="col-sm-10">
                                     <iframe id="document" name="document" width="100%" height="600">
                                    </iframe>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
