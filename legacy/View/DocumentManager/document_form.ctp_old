

<style>

    @keyframes FadeIn {
  from {
    background-color: #7bebbd;
  }
  
  to {
    background-color: white;
  }
}
.block span{
    display: block;
    float: left;
    margin-bottom: 4px;
    width: 33.333%;
  }
.iframeCls {
    background-image: url("http://localhost/forsight/forsight/img/updateimg.gif");   
    background-repeat: no-repeat;
    background-position: 50% 50%;
