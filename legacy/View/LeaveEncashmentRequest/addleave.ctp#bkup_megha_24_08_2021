<script>
    function showencash() {
        var serialize = [];
        serialize = $('#encash').serialize()
        $('#empleaverequeststable').datagrid('load', {id: $('#encash').serialize()});
        $('#empleaverequeststableverified').datagrid('load', {id: $('#encash').serialize()});
    }
    function showencashToBeVerify() {
        $('#empleaverequeststable').datagrid('reload');
    }
    function showencashVerified() {
        $('#empleaverequeststableverified').datagrid('reload');
    }
    function save(s, applied, employee, salaryheaditemsfkey) {
        var input_te = $(s).siblings('input');
        var applied_value = $(input_te).val();
        if (applied == 0) {
            $(s).prop("disabled", true).html("No Balance");
            return false;
        } else {
            $.ajax({
                url: livesite + "LeaveEncashmentRequest/encashemp",
                type: "POST",
				dataType: 'json',
                data: {emp: employee, applied_days: applied_value, salaryheaditemsfkey: salaryheaditemsfkey},
                success: function (resp) {
                    if (resp.msg == true) {
                        //$(s).html('<li class="fa fa-spinner fa-spin"></li>');
                        $(s).fadeOut(90, function () {
                            $(s).parent('div').append('Approved');
                            $('#empleaverequeststable').datagrid('reload');
                            $('#empleaverequeststableverified').datagrid('load');
                        });
                    }else{
					$.notify("Can't approve leave encashment.Payroll Processed for this month. ", {
                            type: 'danger',
                            allow_dismiss: false
                        });
                    return false;
					}
                }
            });
        }
    }
