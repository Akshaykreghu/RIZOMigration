    function loancalculate() {

        var rate1 = $('#intrest_rate').val();
        var amount1 = $('#loan_amount').val();
        var tenure1 = $("#tenure").val();
        if (amount1 < 1 && rate1 < 1 && tenure1 < 1) {
            // alert("Enter valid amount");
