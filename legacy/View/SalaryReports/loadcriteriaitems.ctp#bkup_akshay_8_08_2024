                function openNewDataGrid(data) {
                    var keys = data.map(function(item) {
                        return "'" + item.key + "'";
                    }).join(', ');
                    console.log('Data', keys);
                    var url = livesite + 'salaryReports/listBankBranches/' + keys;

                    // Perform AJAX request
                    $.ajax({
                        url: url,
                        type: 'GET',
                        success: function(response) {
                            response = JSON.parse(response);
                            console.log('Response:', response);
                            console.log('Response:', response.data);

                            // Check if response is an array
                            if (true) {
                                // Update existing datagrid with new data
                                $('#new-datagrid').datalist('loadData', response.data);

                                // Ensure toolbar is visible if it was hidden
                                if (!$('#toolbar').is(':visible')) {
                                    $('#toolbar').show();
                                }
                            } else {
                                console.error('Error: Empty or invalid response data');
                                // Handle the error or notify the user appropriately
                                // For example, display an error message or fallback behavior
                            }
                        },
                        error: function(xhr, status, error) {
                            // Handle errors here
                            console.error('Error:', status, error);
                        }
                    });

                    // Initialize the datagrid if not already initialized
                    if (!$('#new-datagrid').data('datalist')) {
                        $('#new-datagrid').datalist({
                            toolbar: '#toolbar',
                            columns: [
                                [{
                                        field: 'key',
                                        width: 10,
                                        formatter: function(value, row, index) {
                                            return '<input type="checkbox" class="checksubw" name="bank_branch[]" value="' + row.key + '" />';
                                        }
                                    },
                                    {
                                        field: 'Name',
                                        width: 80,
                                        formatter: function(value, row, index) {
                                            return row.text;
                                        }
                                    }
                                ]
                            ],
                            checkOnSelect: true,
                            searchFilter: false,
                            singleSelect: false,
                            lines: true,
                            fitColumns: true,
                            valueField: "key",
                            onLoadSuccess: function() {
                                setSubWidth();
                                togglePrintContainer();
                                //Edited bu Akshay on 3-7-2024
                                $('#print-select').val('');
                                $('#print-select').trigger('change');
                                //End
                            },
                            onCheck: function(index, row) {
                                updateCheckboxState(index, true);
                                togglePrintContainer();
                            },
                            onUncheck: function(index, row) {
                                updateCheckboxState(index, false);
                                togglePrintContainer();
                            }
                        });
