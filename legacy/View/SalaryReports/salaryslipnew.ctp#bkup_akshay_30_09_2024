function formatIndianNumber($number, $decimals = 2)
{

    setlocale(LC_MONETARY, 'en_IN');
    $number = money_format('%!i', $number);
    return  $number;

    $formattedNumber = number_format($number, $decimals, '.', ''); // Format with standard number_format

    // Split the formatted number into integer and decimal parts
    list($integerPart, $decimalPart) = explode('.', $formattedNumber);

    // Insert commas after every two digits in the integer part (without reversing the order)
    $integerPart = implode(',', str_split($integerPart, 2));

    // Join the integer and decimal parts with the Indian decimal separator
    return  $formattedNumber;
}
