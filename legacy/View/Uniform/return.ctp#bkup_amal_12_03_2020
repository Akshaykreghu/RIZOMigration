<script>
    
    function update(s){
        var mode= $('#loan_pkey').val();
        $(s).html('<li class="fa fa-spin fa-spinner"></li>Updating Loan..... Please Wait');
        $.ajax({
                url:livesite+'EmployeeLoan/completed/' + mode,
                success: function(resp){

                  $(s).html('Loan Updated As Completed');
                  
                }
            });
    }
    
    function removei(s,bal,qtys){
        var qty = $(s).parent().siblings().find('.ret_qty').val();
        var item_fkey = $(s).parent().siblings().find('.item_fkey').val();
        var ret_date = $(s).parent().siblings().find('.tr_date').val();
        var emp_fkey = $('.emp_fkey').val();
        var damaged_qty = parseInt($(s).parent().siblings().find('.damaged_qty').val());
        var total = parseInt(qty) + parseInt(damaged_qty);
        if(isNaN(damaged_qty)){
            return false;
        }
        if(ret_date == ''){
            alert("Please Select the Date ");
            return false;
        }
        if(bal < total){
            alert(total);
            alert("Total Returning Qty Should be less than balance Qty ");
            return false;
        }
        if(bal < damaged_qty){
            alert("Damaged Qty Should be less than balance Qty ");
            return false;
            
        }
        if(bal < qty){
            alert("Returning Qty Should be less than balance Qty ");
            return false;
            
        }
//        alert(qty);
    var request = $.ajax({
            url: livesite + "Uniform/return_item",
            data:{qty:qty,pkey:qtys,item_fkey:item_fkey,emp_fkey:emp_fkey,damaged_qty:damaged_qty,ret_date:ret_date},
            method: "POST",
        });
        
        
        request.done(function( msg ) {
            $(s).html("success").attr("disabled",true).removeClass("btn-primary").addClass("btn-success");
            alert(msg);
            $('#att_table').datagrid('load');
        });
        
        request.fail(function( jqXHR, textStatus ) {
            alert( "Request failed: " + textStatus );
        });
    
    }
   
    jQuery(document).ready(function () {

        $('.tr_date').datepicker({
            format: 'yyyy-mm-dd',       
            autoclose: true,
            startDate:'<?php echo $allocate_master['0']['itm_allocation']['date_allocated'];?>',
            endDate: '0d'
        });

        $('#Purchase_form').on('submit', function (event) {
            event.preventDefault();

            if (confirm("Do You Want To Save The Form")) {
                $('#Purchase_form').ajaxSubmit(options);
            }
        });
        var options = {
            success: function (resp) {
                var row = $('#materialtable').datagrid('getSelected');
                //console.log(row);



                $('#largeModalForm').modal('hide');
                $('#materialtable').datagrid('reload');

                var pk = $("#po_fkey").val();
                //alert(pk);

                loadtable(pk, 1);

                $.notify("Success", {
                    type: 'success',
                    allow_dismiss: false
                });
            }  // post-submit callback
        };
    });






</script>