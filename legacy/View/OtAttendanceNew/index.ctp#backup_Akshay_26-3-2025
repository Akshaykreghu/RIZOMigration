<script>
    function showLargeModalForm1(url) {
        var container = $("#modalDetailForm12 #modaldetails-content12");


        container.load(url, function() {
            $("#modalDetailForm12").modal('show')
        });
    }

    function getDurationRegister(callback) {
        var employee = $('#emp_fkey').val();
        var month = $('#filterby_month').val();
        var branch = $('#filterby_branch').val();

        $.ajax({
            url: livesite + "OtAttendanceNew/getDurationRegister",
            type: "POST",
            dataType: "json",
            data: {
                month: month,
                emp: employee,
                branch: branch
            },
            success: function(res) {
                // Check duration response
                if (res && res[0] && res[0][0] && res[0][0].duration === "OK") {
                    if (callback) callback();
                } else {
                    console.warn("Duration result not OK");
                    $('#loader').hide();
                }
            },
            error: function(xhr, status, error) {
                console.error("Error:", error);
                $('#loader').hide();
            }
        });
    }

    function filterRegister(obj) {
        $('#loader').show();

        getDurationRegister(function() {

            var status = '';
            if ($('#tab1').hasClass('active')) {
                status = 'Pending';
            } else if ($('#tab2').hasClass('active')) {
                status = 'Processed';
            }

            var employee = $('#emp_fkey').val();
            var month = $('#filterby_month').val();
            var branch = $('#filterby_branch').val();

            $('#att_table').datagrid('load', {
                month: month,
                emp: employee,
                branch: branch,
            });

            $('#loader').hide();
        });
    }


    function switchTab(tabId, contentId) {

        // Remove active class from all tabs & contents
        $('.tab').removeClass('active');
        $('.tab-content').removeClass('active');

        // Add active class to clicked elements
        $('#' + tabId).addClass('active');
        $('#' + contentId).addClass('active');

        // Determine status from active tab
        let status = '';
        if (contentId === 'tab1') {
            status = 'Not Processed';
            $('#approveAllBtn').show();
            $('#filterDiv').show();
            $('#removeBtn').hide();
            // Show / hide columns
            $('#att_table').datagrid('showColumn', 'eligible');
            $('#att_table').datagrid('showColumn', 'set_duration_min');
            $('#att_table').datagrid('showColumn', 'new_ot_duration_hrs');
            $('#att_table').datagrid('showColumn', 'total_ot_duration_hrs');
            $('#att_table').datagrid('hideColumn', 'approved_duration_min');
            $('#att_table').datagrid('hideColumn', 'approved_duration_hrs');

        } else if (contentId === 'tab2') {
            status = 'Processed';
            $('#approveAllBtn').hide();
            $('#filterDiv').hide();
            $('#removeBtn').show();

            // Hide checkbox column, Eligible, and OT in hrs
            $('#att_table').datagrid('hideColumn', 'eligible');
            $('#att_table').datagrid('hideColumn', 'set_duration_min');
            $('#att_table').datagrid('hideColumn', 'new_ot_duration_hrs');
            $('#att_table').datagrid('hideColumn', 'total_ot_duration_hrs');
            $('#att_table').datagrid('showColumn', 'approved_duration_min');
            $('#att_table').datagrid('showColumn', 'approved_duration_hrs');
        }

        // Determine URL based on status
        var url = (status === 'Not Processed') ?
            livesite + "OtAttendanceNew/getNotApprovedData" :
            livesite + "OtAttendanceNew/getApprovedData";

        // Update URL
        $('#att_table').datagrid('options').url = url;

        // Reload with filters
        $('#att_table').datagrid('load', {
            month: $('#filterby_month').val(),
            emp: $('#emp_fkey').val(),
            branch: $('#filterby_branch').val()
        });
    }


    function filterEmployees() {
        var branch = $('#filterby_branch').val();
        var structure = $('#approved_bys').val();
        var fileInput = $('#empctccsv');
        var month = $('#filterby_month').val();
        if ($('#approved_bys').val() !== '') {
            fileInput.prop('disabled', false);
        } else {
            fileInput.prop('disabled', true);
        }

        $("#emp_fkey").select2({
            placeholder: "--Select--",
            allowClear: true,
            ajax: {
                url: function() {
                    return livesite + "OtAttendanceNew/jsons/" +
                        branch + "/0/" +
                        $('#filterby_month').val();
                },
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        q: params.term,
                        page: params.page
                    };
                },
                processResults: function(data, params) {
                    var selectElement = this.$element;
                    var selectId = selectElement.attr('id');

                    params.page = params.page || 1;

                    return {
                        results: data.items,
                        pagination: {
                            more: (params.page * 30) < data.total_count
                        }
                    };
                }
            },
            escapeMarkup: function(markup) {
                return markup;
            }
        });
    }


    function disableInvalidCheckboxes() {
        const dg = $('#att_table');
        const rows = dg.datagrid('getRows');
        const panel = dg.datagrid('getPanel');

        let allValidChecked = true;
        let hasValidRow = false;

        rows.forEach((row, index) => {
            if (row.emp_ot_master_pkey == 0) {
                dg.datagrid('uncheckRow', index);

                $(panel)
                    .find(`tr[datagrid-row-index="${index}"] input[type="checkbox"]`)
                    .prop('disabled', true)
                    .css('cursor', 'not-allowed')
                    .prop('checked', false);
            } else {
                hasValidRow = true;
                // If any valid row is not checked, allValidChecked = false
                if (!dg.datagrid('getChecked').includes(row)) {
                    allValidChecked = false;
                }
            }
        });

        if (!hasValidRow) {
            allValidChecked = false;
        }

        // If all valid rows are checked, tick the select-all checkbox manually
        if (allValidChecked) {
            $(panel).find("div.datagrid-header-check input[type='checkbox']").prop("checked", true);
        } else {
            $(panel).find("div.datagrid-header-check input[type='checkbox']").prop("checked", false);
        }
    }








