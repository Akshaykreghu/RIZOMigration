        });

        // Clear filter
        $('#clearFilter').on('click', function() {
            $('#filterPanel input[name="filtering"]').prop('checked', false);
            var employee = $('#emp_fkey').val();
            var month = $('#filterby_month').val();
            var branch = $('#filterby_branch').val();

            $('#att_table').datagrid('load', {
                month: month,
                emp: employee,
                branch: branch,
