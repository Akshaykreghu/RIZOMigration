        $('#removeBtn').click(function() {
            // Array to store details of selected rows
            var selectedRows = $('#att_table').datagrid('getSelections');
            var month = $('#filterby_month').val() + '-01';


            if (selectedRows.length === 0) {
                $.notify('Please select a row.', {
                    type: 'danger',
                    allow_dismiss: false
                });
                return;
            }

            var pkeys = selectedRows.map(function(row) {
                return row.emp_ot_master_pkey;
            });

            console.log('Pkeys', pkeys);

            // Call Remove API only
            // Edited by Akshay on 6-2-2026
            $.ajax({
                type: 'POST',
                url: livesite + 'OtAttendanceNew/remove',
                data: {
                    pkeys: pkeys,
                    month: month
                },
                success: function(response) {
                    var data = JSON.parse(response);
                    console.log('Response', data);

                    if (data.success === true) {

                        $.notify("Removed the employees successfully", {
                            type: 'success',
                            allow_dismiss: false
                        });

                        // 🔄 Reload datagrid ONLY after success
                        $('#att_table').datagrid('load', {
                            month: $('#filterby_month').val(),
                            emp: $('#emp_fkey').val(),
                            branch: $('#filterby_branch').val(),
                            status: ''
                        });

                    } else {
                        $.notify(data.message || "Failed to remove employees", {
                            type: 'danger',
                            allow_dismiss: false
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error sending pkeys:', error);
                    $.notify("Error occurred while removing employees", {
                        type: 'danger',
                        allow_dismiss: false
                    });
                }
            });

            // End
        });
        // End

    });


