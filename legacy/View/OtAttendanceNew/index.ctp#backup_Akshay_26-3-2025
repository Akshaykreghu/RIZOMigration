    $('#approveAllBtn').click(function() {

        var selectedRows = $('#att_table').datagrid('getSelections');
        if (selectedRows.length === 0) {
            $.notify("Please select at least one row", {
                type: 'danger',
                allow_dismiss: false
            });
            return;
        }

        var month = $('#filterby_month').val();

        // Build employees array with emp_fkey + value from input field
        var employees = selectedRows.map(function(row, index) {

            var inputSelector = 'input[name="et_duration_min' + row.emp_ot_master_pkey + '"]';
            var inputVal = parseFloat($(inputSelector).val()) || 0;

            return {
                emp_fkey: row.emp_fkey,
                set_duration_min: inputVal
            };
        });


        $.ajax({
            url: livesite + 'OtAttendanceNew/approves',
            type: 'POST',
            data: {
                month: month,
                employees: employees
            },
            success: function(resp) {
                resp = JSON.parse(resp);
                console.log(typeof resp);

                if (resp.status == 'success') {
                    $.notify(resp.message ? resp.message : "Approved Successfully", {
                        type: 'success'
                    });
                } else {
                    $.notify("Attendance already processed", {
                        type: 'danger'
                    });
                }

                // Reload datagrid
                var employee = $('#emp_fkey').val();
                var branch = $('#filterby_branch').val();

                $('#att_table').datagrid('load', {
                    month: month,
                    emp: employee,
                    branch: branch,
                    status: ''
                });
            },
            error: function() {
                $.notify("Error Occurred", {
                    type: 'danger'
                });
            }
        });

    });
