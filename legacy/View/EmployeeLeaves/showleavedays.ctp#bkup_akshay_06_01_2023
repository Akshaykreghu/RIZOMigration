<script>
function approveleave(){
if (confirm("Are you sure want to approve this leave? ")) {
                                  $.ajax({
                                    url: livesite + "EmployeeLeaves/approveleave",
                                    data: {
                                        LEAVEENTRYIDS: <?php echo $id; ?>
                                    },
                                    success: function (response) {
                                          var response = $.parseJSON(response);
                                        if (response.msg) {
                                            $.notify(response.msg, {
                                                type: 'success',
                                                allow_dismiss: true
                                             });
                                        }
                                        reloadTable('leave_table');
                                    }
                                });
                            }
}
function cancelleave(){
if (confirm("Are you sure want to cancel the leave? ")) {
                                  $.ajax({
                                    url: livesite + "EmployeeLeaves/deleteleave",
                                    data: {
                                        LEAVEENTRYIDS: <?php echo $id; ?>
                                    },
                                    success: function (response) {
                                          var response = $.parseJSON(response);
                                        if (response.msg) {
                                            $.notify(response.msg, {
                                                type: 'success',
                                                allow_dismiss: true
                                             });
                                        }
                                        reloadTable('leave_table');
                                    }
                                });
                            }
}
</script>