                                            <option value="0">All</option>
                                            
                                            <?php 
                                            $statusText = array('','Generated','To be approved','Approved and Closed');
                                            foreach ($status as $key => $value) { 
                                            ?>                              
                                                <option  value="<?php echo $value['efsr_tickets']['status']; ?>">
