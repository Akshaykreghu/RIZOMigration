<script>
//value check 
    function  valuecheck()
    {
        var avil = parseInt($('#sumdata').val());
        var req = parseInt($('#required_qty').val());
        if (avil < req)
        {
            alert("Please Check Available Qty ");
            $("#required_qty").val('');
        }
    }
//itemname check
    function checkitem()
    {
        var item = $('#item_desc').val();
        if (item != '')
        {
            $("#item_code").val('');
        }
    }
//itemcode check
    function checkitemcode()
    {
        var itemcode = $('#item_code').val();
        if (itemcode != '')
