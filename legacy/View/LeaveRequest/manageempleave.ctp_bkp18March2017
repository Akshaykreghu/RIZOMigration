function grandLeave(obj){
    var actionType = $.trim($(obj).html());
    $(obj).html('<li class="fa fa-spinner fa-spin"></li>Please Wait').prop("disabled","disabled");
    $('#actionType').val(actionType);
    $('#employeeleaverequestform').ajaxSubmit(empleaverequestoptions);
}
function changeApprovedBy() {
    $('#approveByDisplayfield').hide();
    $('#approveByCombobox').show();
}

function cancelApprovedBy() {
    $('#approveByDisplayfield').show();
    $('#approveByCombobox').hide();
    if($('#curusername').val() ==  $.trim($('#APPROVEDBYNAME').html())){
        $('#actionType').val('Approve');
        $('#btn-grandemployeeleave').val('Approve');
        $('#btn-grandemployeeleave').html('Approve');
    }else{
        $('#actionType').val('Authorize');
        $('#btn-grandemployeeleave').val('Authorize');
        $('#btn-grandemployeeleave').html('Authorize');
    }
}

function pickApprovedBy() {
    if($('#curuserid').val() ==  $('#APPROVEDBY').val()){
        $('#actionType').val('Approve');
        $('#btn-grandemployeeleave').val('Approve');
        $('#btn-grandemployeeleave').html('Approve');
    }else{
        $('#actionType').val('Authorize');
        $('#btn-grandemployeeleave').val('Authorize');
        $('#btn-grandemployeeleave').html('Authorize');
    }
    $('#approveByDisplayfield').show();
    $('#approveByCombobox').hide();
    
    var pickedPerson = $("#APPROVEDBY option:selected").text();
    $('#APPROVEDBYNAME').html(pickedPerson+'&nbsp;&nbsp;&nbsp;<button type="button" id="btn-changeApprovedBy" class="btn btn-default" onclick="changeApprovedBy()">Change</button>');
}
