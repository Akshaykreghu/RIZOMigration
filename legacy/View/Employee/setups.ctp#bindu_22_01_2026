<script>
    $(document).ready(function() {

        var emp_fkey = $("input[name='emp_fkey']").val();

        // --- INITIAL SETUP ---
        $('#userGroupCheckbox').prop('checked', false);
        $('#edit-section-checkboxes').hide();

        // Disable everything initially
        disableAllSections();

        var editableValue = <?php echo isset($arr_emp_details['editable']) ? $arr_emp_details['editable'] : '0'; ?>;

        // --- IF USER HAS EDITABLE RIGHTS ---
        if (editableValue > 0) {
            $('#userGroupCheckbox').prop('checked', true);
            $('#edit-section-checkboxes').show();

            var map = {
                1: [true, false, false],
                2: [false, true, false],
                3: [false, false, true],
                4: [true, true, false],
                5: [false, true, true],
                6: [true, false, true],
                7: [true, true, true]
            };

            var checks = map[editableValue] || [false, false, false];

            $('#chkPersonal').prop('checked', checks[0]);
            $('#chkOther').prop('checked', checks[1]);
            $('#chkOnboarding').prop('checked', checks[2]);

            setSectionAccess(checks[0], checks[1], checks[2]);
        }

        // --- MAIN EDITABLE TOGGLE ---
        $('#userGroupCheckbox').on('change', function() {
            if ($(this).is(':checked')) {
                // Show section checkboxes
                $('#edit-section-checkboxes').fadeIn(200);
            } else {
                // Hide section checkbox panel
                $('#edit-section-checkboxes').fadeOut(200);

                // Uncheck all options
                $('#chkPersonal, #chkOther, #chkOnboarding').prop('checked', false);

                // Disable all sections
                disableAllSections();

                // Update DB to set editable = 0
                updateEditableInDB();
            }
        });

        // --- SECTION-WISE TOGGLES ---
        $('#chkPersonal, #chkOther, #chkOnboarding').on('change', function() {
            setSectionAccess(
                $('#chkPersonal').is(':checked'),
                $('#chkOther').is(':checked'),
                $('#chkOnboarding').is(':checked')
            );
            updateEditableInDB();
        });

        // --- FUNCTIONS ---
        function disableAllSections() {
            $("#employee-form :input:not(:button):not([type='submit']):not([type='reset']), \
              #empsetuppersonal :input, \
              #empsetupconfig :input:not(:button):not([type='submit']):not([type='reset'])")
                .prop('disabled', true);
        }

        function setSectionAccess(personal, other, onboarding) {
            $("#employee-form :input:not(:button):not([type='submit']):not([type='reset'])").prop('disabled', !personal);
            $("#empsetuppersonal :input").prop('disabled', !other);
            $("#empsetupconfig :input:not(:button):not([type='submit']):not([type='reset'])").prop('disabled', !onboarding);
        }

        function calculateEditableValue() {
            var personal = $('#chkPersonal').is(':checked');
            var company = $('#chkOther').is(':checked');
            var onboarding = $('#chkOnboarding').is(':checked');

            if (personal && !company && !onboarding) return 1;
            if (!personal && company && !onboarding) return 2;
            if (!personal && !company && onboarding) return 3;
            if (personal && company && !onboarding) return 4;
            if (!personal && company && onboarding) return 5;
            if (personal && !company && onboarding) return 6;
            if (personal && company && onboarding) return 7;
            return 0;
        }

        function updateEditableInDB() {
            var newValue = calculateEditableValue();
            const empPkey = $('#emp_pkey').val();

            $.ajax({
                url: '/Employee/updateEditable',
                type: 'POST',
                data: {
                    emp_pkey: empPkey,
                    editable: newValue
                },
                dataType: 'json',
                success: function(res) {
                    if (res.status === 'success') {
                        $.notify('Editable updated successfully!', {
                            type: 'success',
                            z_index: 99999
                        });
                    } else {
                        $.notify(res.message || 'Error updating editable.', {
                            type: 'danger',
                            z_index: 99999
                        });
                    }
                },
                error: function(xhr, status, error) {
                    $.notify('AJAX error: ' + error, {
                        type: 'danger',
                        z_index: 99999
                    });
                }
            });
        }
    });
