<script>
$(document).ready(function () {

    var userGroup = parseInt('<?php echo (int)$user_group; ?>', 10);
    var editableValue = parseInt('<?php echo isset($arr_emp_details['editable']) ? (int)$arr_emp_details['editable'] : 0; ?>', 10);

    function toggleImageControls() {

        /* ===== USER GROUP 2 ===== */
        if (userGroup === 2) {

            // editable must be 1,5,7
            if ($.inArray(editableValue, [1, 5, 7]) !== -1) {
                $('#imageControls').show();
            } else {
                $('#imageControls').hide();
            }
            return; // stop here
        }

        /* ===== USER GROUP 1 ===== */
        if (userGroup === 1) {

            // master hide
            if (!$('#userGroupCheckbox').is(':checked')) {
                $('#imageControls').hide();
                return;
            }

            // show condition
            if ($('#chkPersonal').is(':checked')) {
                $('#imageControls').show();
            } else {
                $('#imageControls').hide();
            }
        }
    }

    // page load
    toggleImageControls();

    // checkbox change
    $(document).on('change', '#chkPersonal, #userGroupCheckbox', function () {
        if (userGroup === 1) {
            toggleImageControls();
        }
    });

});
</script>
