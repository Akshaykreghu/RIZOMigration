    $('#educationFormModal').on('submit', function(e) {
        e.preventDefault();

        const $form = $(this);
        const $submitBtn = $form.find('button[type="submit"]');

        // 🧠 Prevent multiple clicks
        if ($submitBtn.prop('disabled')) return;

        $submitBtn.prop('disabled', true).text('Saving...');

        let formData = new FormData(this);
        const empPkey = $('#emp_pkey').val();
        if (empPkey) {
            formData.append('emp_fkey', empPkey);
        }

        $.ajax({
            url: '/Employee/savequalificationsjoin',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function(response) {
                try {
                    const res = JSON.parse(response);
                    $.notify(res.message || 'Education data saved successfully!', {
                        type: 'success',
                        z_index: 99999
                    });
                } catch (e) {
                    $.notify('Unexpected server response. Please try again.', {
                        type: 'danger',
                        z_index: 99999
                    });
                } finally {
                    $form[0].reset();
                    $('#educationModal').modal('hide');
                    loadEducationTable();
                    $submitBtn.prop('disabled', false).text('Save');
                }
            },
            error: function(xhr) {
                $.notify('Something went wrong. Please try again.', {
                    type: 'danger',
                    z_index: 99999
