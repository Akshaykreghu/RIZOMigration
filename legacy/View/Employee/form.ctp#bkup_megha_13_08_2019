//validation form amount
    function findamount() {
        var rate = $('#emp_anual_ctc').val();
//number format
        ///^[1-9][0-9\.]{0,15}$/
        ///^\d+$/
        if (rate.match(/^[1-9][0-9\.]{0,15}$/)) {
            if (rate < 1)
            {
                alert('Please Enter A Valid Amount')
                $("#emp_anual_ctc").val('');
            }
        } else {
            $("#emp_anual_ctc").val('');
        }
    }
