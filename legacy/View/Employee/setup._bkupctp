                                                            </div>';
                                                    if($index == count($arr_taxheads)){
                                                        //End last row
                                                        echo '</div>'; 
                                                    }
                                                }else{
                                                    //End current row
                                                    echo '<div class="col-md-6">
                                                            <label style="text-align:left;" class="col-md-4 control-label" for="'.$fieldid.'">'.$fieldname.'</label>
                                                            <div class="col-md-6">
