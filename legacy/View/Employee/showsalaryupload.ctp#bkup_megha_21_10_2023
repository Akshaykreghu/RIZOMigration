    function resizePWSTabContentDiv(tabIndex) {
        if ($("div#tab" + tabIndex).hasClass("pws_tabs_scale_show")) {
            var divHeight = $("div#tab" + tabIndex).height();
            $("div.tabset-salaryrevisions").height(divHeight);
        }
    }
