            <div class="box-body">
                <div class="tabset-salaryrevisions">
                    <div id="tab1" data-pws-tab="tab1" data-pws-tab-name="Salary Revision" data-pws-tab-icon="fa-money" style="height: 800px;">

                    </div>
                    <div id="tab2" data-pws-tab="tab2" data-pws-tab-name="Components Upload" data-pws-tab-icon="fa-cloud-upload" style="height: 800px;">

