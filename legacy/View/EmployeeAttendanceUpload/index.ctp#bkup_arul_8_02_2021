    function filterAttendanceupload(obj) {
        var branch = $('#attendanceuploadfilter #filterby_branch').val();
        var employee = $('#attendanceuploadfilter #emp_fkey').val();
        var month = $('#attendanceuploadfilter #filterby_month').val();
