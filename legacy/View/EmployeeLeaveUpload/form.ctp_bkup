    /*
     * Get leave balanace for the current employee for the leave type chosen
     * On 15 Oct 2016
     */
    function getLeaveBalance(type, employee, end_date) {
    $.ajax({
    url: livesite + 'EmployeeLeaveUpload/GetLeaveBalance/' + type + '/' + employee + '/' + end_date,
            type: 'POST',
            success: function (resp)
            {
            var yearly_balance = $.parseJSON(resp).yearly_balance;
            var monthly_balance = $.parseJSON(resp).monthly_balance;
            $('#hid_yearly_balance').val(yearly_balance);
            $('#hid_monthly_balance').val(monthly_balance);
            $('#Leavebalance').html('Yearly Balance : ' + yearly_balance + ', Monthly Balance : ' + monthly_balance);
            $('#leave-balance-info').show();
            var allow_negative = $.parseJSON(resp).allow_negative;
            if (monthly_balance == 0 && allow_negative != 'Y'){
            $('.strict-field').attr('disabled', true);
            } else{
            $('.strict-field').attr('disabled', false);
            }

            }
    });
    }
