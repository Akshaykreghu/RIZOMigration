        filterEmployees();
    }


    function uploadEmployeeCTC(s) {
        var form = $('#leaveuploadfilter');
        var fileSelect = document.getElementById('lesa');
//        alert($(fileSelect).val()); 
        if($(fileSelect).val() == ''){
            alert("Please Choose a File ! ");
            return false;
        }
        
        var ctcuploadtype = 3;
        $(s).html('Uploading  .. <li class="fa fa-spinner fa-spin" ></li>');
        // The rest of the code will go here...
        var files = fileSelect.files;
        // Create a new FormData object.
        var formData = new FormData();
        //alert (formData);
        // Loop through each of the selected files.

        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            // Add the file to the request.
            formData.append('empctc[]', file, file.name);
        }

        // Set up the request.
        var xhr = new XMLHttpRequest();

        // Open the connection.
        xhr.open('POST', livesite + 'EmployeeLeaveUpload/uploadandsaveempctc/' + ctcuploadtype, true);

        // Set up a handler for when the request finishes.
        xhr.onload = function () {
            if (xhr.status === 200) {
                // File(s) uploaded.
                $(s).html('Upload Leave');
                var response = JSON.parse(xhr.responseText);
                if (response.success) {

                    $.notify(response.msg, {
                        type: 'success',
                        allow_dismiss: false
                    });
//                     filterleaveupload();
                    //$('#leave_table').datagrid();
                    $("#leaveuploadfilter").resetForm();
                    $('#leave_table').datagrid('reload');
                    var employees = response.employees;
                    var PIDs = response.PIDS;
                    var startedTime = response.started_time;
                    var importedCount = response.imported_count;
                    showModalForm(livesite+'EmployeeLeaveUpload/showfailedleaverequests/'+importedCount+'/'+startedTime+'/'+PIDs);

                } else {
                    $.notify(response.msg, {
                        type: 'error',
                        allow_dismiss: false
                    });
                }
            } else {
                alert("Employee Leave import failed, please check informations given or try again.");
            }
        };

        $('#lesa').val('');
        $("#filterby_branch").select2("val", "");
        $("#emp_fkey").select2("val", "");

        // Send the Data.
        xhr.send(formData);
    }
