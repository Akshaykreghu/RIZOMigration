<script>
    function filterAttendanceupload(obj) {
        var branch = $('#importvariableform #filterby_branch').val();
        var employee = $('#importvariableform #emp_fkey').val()
        var month = $('#importvariableform #filterby_month').val()
        var salhead = $('#importvariableform #salary_head_item').val()


        $('#att_table').datagrid('load', {
            branch: branch,
            employee: employee,
            month: month,
            salhead: salhead,
        });

    }

    function downloadVariableUploadForm() {
        var salary_head_item = $('#salary_head_item').val();

        var filterby_branch = $('#filterby_branch').val();
        if (salary_head_item != "") {
            window.open('<?php echo $this->webroot; ?>Variable/downloadvariableuploadform/' + salary_head_item + '/' + filterby_branch);
        } else {
            alert("select head item");
            return false;
        }
    }
    function uploadVariable() {
        var salary_head_item = $('#salary_head_item').val();
        if (salary_head_item != "") {
            
        } else {
            alert("select head item");
            return false;
        }
        
        var form = $('#importvariableform');
        var fileSelect = document.getElementById('empvarcsv');
        var salary_head_item = $('#salary_head_item').val();
        var month_year = $('#filterby_month').val();

        // The rest of the code will go here...
        var files = fileSelect.files;
        // Create a new FormData object.
        var formData = new FormData();
        // Loop through each of the selected files.

        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            // Add the file to the request.
            formData.append('empvar[]', file, file.name);
        }

        // Set up the request.
        var xhr = new XMLHttpRequest();

        // Open the connection.
        xhr.open('POST', livesite + 'Variable/uploadandsaveempvar/' + salary_head_item + '/' + month_year, true);

        // Set up a handler for when the request finishes.
        xhr.onload = function () {
            if (xhr.status === 200) {
                // File(s) uploaded.
				$('#empvarcsv').val("");
                var response = JSON.parse(xhr.responseText);
                if (response.success) {
                    $.notify(response.msg, {
                        type: 'success',
                        allow_dismiss: false
                    });
                    $('#att_table').datagrid('load');
                } else {
                    $.notify(response.msg, {
                        type: 'error',
                        allow_dismiss: false
                    });
                    $('#att_table').datagrid('load');
                }
            } else {
                alert("Employee CTC import failed, please check informations given or try again.");
            }
        };

        // Send the Data.
        xhr.send(formData);
    }


    jQuery(document).ready(function () {
        var employee = $('#attendanceuploadfilter #emp_fkey').val();

        $('#emp_fkey').select2();
        
        $('#att_table').datagrid({
            url: livesite + "Variable/employeelistvariable",
            pagination: true,
            singleSelect: true,
            rownumbers: true,
            queryParams: {
                employee: employee
            },
            toolbar: [{
                    text: 'New',
                    iconCls: 'icon-add',
                    handler: function () {
                        showModalForm(livesite + 'Variable/form')
                    }
                }
                ,'-', {
                   iconCls: 'icon-edit',
                 text: 'Edit',
                   handler: function () {
                     var row = $('#att_table').datagrid('getSelected');
                   if (row) {

                                          showModalForm(livesite + 'Variable/form/'+row.emp_variables_upload_pkey);
                                    } else {
                                      alert("Please select a record to edit")
                                }
                          }
                    },'-', {
                    iconCls: 'icon-remove',
                    text: 'Remove',
                    handler: function () {
                        var rows = $('#att_table').datagrid('getSelections');
                        if (rows) {
                            var str_ids = "";
                            for (var i = 0; i < rows.length; i++) {
                                var data = rows[i];
                                if (str_ids == "") {
                                    str_ids += data.emp_variables_upload_pkey;
                                } else
                                {
                                    str_ids += "," + data.emp_ctc_upload_pkey;
                                }
                            }
                            if (confirm("Are you sure want to delete ")) {

                                $.ajax({
                                    url: livesite + "Variable/deleteEmployees",
                                    data: {
                                        emp_ctc_upload_pkey: str_ids
                                    },
                                    success: function (response) {

                                        var response = $.parseJSON(response);
                                        if (response.msg) {
                                            $.notify(response.msg, {
                                                type: 'success',
                                                allow_dismiss: true

                                            });
                                            $('#att_table').datagrid('load');
                                        }


                                       
                                    }
                                }); 
                                

                            }

                        }

                    }
             
                }
            ],
            fitColumns: true,
            pageList: [2, 5, 10, 50, 100],
            columns: [[
                    //{field: 'emp_ctc_upload_pkey', title: '', width: "20%"},
                    {field: 'empname', title: 'Employee Name', width: "15%"},
                    {field: 'salary_head_item_desc', title: 'Salary Head', width: "15%"},
                    {field: 'uploaded_amount', title: 'Amount', width: '10%'},
                    {field: 'head_operator', title: 'Operator ', width: '15%'},
                    {field: 'head_type', title: 'Type', width: '10%'},
                    {field: 'item_part', title: 'Item Part', width: '10%'},
                    {field: 'month_year', title: 'Month ', width: '15%'},
                    {field: 'remarks', title: 'Remarks', width: '12%'},
                ]]
        });
    });
