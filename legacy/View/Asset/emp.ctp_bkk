<script type="text/javascript">
function showassets()
{
    var emp_pkey = $('#pkey').val();
 var url = livesite+'Asset/Allocatenew/'+emp_pkey;
        
        var container = $("#modalDetailForm #modaldetails-content")
container.load(url, function() {
            $("#modalDetailForm").modal('show');
        });
}

 $(document).ready(function() {

 var selected = [];
         
         $('#Assets tbody').on('click', 'tr', function () {
//        var id = table1.row(this).data().allocate_pkey;
//        var index = $.inArray(id, selected);
//        //alert(index);
//        if ( index === -1 ) {
//            selected.push( id );
//        } else {
//            selected.splice( index, 1 );
//        }
//        //alert(selected.length);
//        $(this).toggleClass('selected');
//        
//        
        
        
        
        
        
              
 if ( $(this).hasClass('selected') ) {
            $(this).removeClass('selected');
            var id = null;
        }
        else {
            //table1.$('tr.selected').removeClass('selected');
            $(this).siblings().removeClass('selected');
            $(this).addClass('selected');
            var id = table1.row(this).data().allocate_pkey;
        var index = $.inArray(id, selected);
        }
        selected = id;
        
        
        
    } );
    $('#edites').click( function () {
        if(selected != '')
            {
     var url = livesite+'Asset/edit/'+selected;
        
        var container = $("#modalDetailForm #modaldetails-content")
container.load(url, function() {
            $("#modalDetailForm").modal('show');
        });
            }
            else
            {
                alert("Please select a row first");
            }
    } );
   

   
var emp_pkey = $('#pkey').val();
 var table1 = $('#Assets').DataTable( {
        "processing": true,
        "serverSide": true,
        "paging": false,
             "deferRender": false,
            "pageNumber":false,
            "lengthChange": true,
            "searching": false,
            "ordering": false,
            "singleSelect":true,
            "info": false,
            "autoWidth": true,
            "rowCallback": function( row, data ) {
            if ( $.inArray(data.allocate_pkey, selected) !== -1 ) {
                $(row).addClass('selected');
            }},
        "ajax": {
            "url": "Asset/listitems/"+emp_pkey,
            "type": "POST"
        },
        "columns": [
            { "data": "Type" },
            { "data": "name" },
            { "data": "model" },
            { "data": "brand" },
            { "data": "serial_no" },
            { "data": "allocated_date" },
            { "data": "retreived_date" },
            { "data": "allocated_status" }
        ]
    } );
    } );
        
   
</script>
