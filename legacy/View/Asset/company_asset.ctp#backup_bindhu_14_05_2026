    function forceFixedHeight() {
        setTimeout(function() {
            $('.datagrid-view').css('height', '420px');
            $('.datagrid-wrap').css('height', '450px');
            $('#AssetsTable').datagrid('resize', {
                height: 420
            });
        }, 100);
    }

    function adjustGridHeight(totalRows) {
        let rowHeight = 40;
        let headerHeight = 40;
        let minHeight = 200;
        let maxHeight = 600;

        let newHeight = (totalRows * rowHeight) + headerHeight;

        if (newHeight < minHeight) newHeight = minHeight;
        if (newHeight > maxHeight) newHeight = maxHeight;

        $('#AssetsTable').datagrid('resize', {
            height: newHeight
        });
    }
    // edited by bindu 03-01-2026
    var selected = null;

    $(function() {

        /* ---------- DATAGRID INIT ---------- */
        $('#AssetsTable').datagrid({
            queryParams: {
                asset_status: 'not_allocated'
            },
            onClickRow: function(i, row) {
                selected = row.asset_pkey;
            },
            onLoadSuccess: function() {
                var rows = $('#AssetsTable').datagrid('getRows');
                rows.forEach(function(r, i) {
                    if (r.asset_state === 'Not Working') {
                        $('tr[datagrid-row-index="' + i + '"]')
                            .css('background-color', '#DF9292');
                    }
                });
            }
        });

        /* ---------- SEARCH ---------- */
        let timer;
        $('#user').on('keyup', function() {
            clearTimeout(timer);
            timer = setTimeout(reloadGrid, 300);
        });

        /* ---------- STATUS DROPDOWN CHANGE ---------- */
        $('#assetStatusFilter').on('change', function() {
            reloadGrid();
        });
    });

    /* ---------- COMMON RELOAD ---------- */
    function reloadGrid() {
        $('#AssetsTable').datagrid('load', {
            q: $('#user').val(),
            asset_status: $('#assetStatusFilter').val() // ✅ FIX
        });
    }
</script>
