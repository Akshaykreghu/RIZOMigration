<script type="text/javascript">
    var selected = null;


    function AddnewAssets() {
        var url = livesite + 'Asset/addnew';
        var container = $("#modalDetailForm #modaldetails-content");
        container.load(url, function() {
            $("#modalDetailForm").modal('show');
        });
    }

    $(function() {

        $('#AssetsTable').datagrid({
            onClickRow: function(index, row) {
                selected = row.asset_pkey;
            },
            onLoadSuccess: function(data) {
                var rows = $('#AssetsTable').datagrid('getRows');
                var totalRows = rows.length;

                for (var i = 0; i < totalRows; i++) {
                    if (rows[i].asset_state === "Not Working") {
                        $('tr[datagrid-row-index="' + i + '"]').css('background-color', '#DF9292');
                    }
                }

                var pageSize = $('#AssetsTable').datagrid('getPager')
                    .data("pagination").options.pageSize;
                if (pageSize === 10) {
                    if (totalRows === 10) {
                        forceFixedHeight();
                    } else {
                        adjustGridHeight(totalRows);
                    }
                } else {
                    adjustGridHeight(totalRows);
                }
            }
        });


        let searchTimer;
        $('#user').on('keyup', function() {
            clearTimeout(searchTimer);
            let val = $(this).val();
            searchTimer = setTimeout(function() {
                $('#AssetsTable').datagrid('load', {
                    q: val
                });
            }, 300);
        });

        $('#NewAssets').click(function() {
            if (selected) {
                var url = livesite + 'Asset/addnew/' + selected;
                var container = $("#modalDetailForm #modaldetails-content");
                container.load(url, function() {
                    $("#modalDetailForm").modal('show');
                });
            } else {
                alert("Please select a row first");
            }
        });

        $('#Detailed').click(function() {
            if (selected) {
                var url = livesite + 'Asset/details/' + selected;
                var container = $("#modalDetailForm #modaldetails-content");
                container.load(url, function() {
                    $("#modalDetailForm").modal('show');
                });
            } else {
                alert("Please select a row first");
            }
        });


       
