            $('#modalDetailForm').modal('hide');
            $("#AssetsTable").DataTable().ajax.reload();
             $.notify("Asset Created And Saved Successfully",{
                            type: 'success',
                            allow_dismiss: false
                        });
        }
    };

    // bind to the form's submit event
    $('#Allocateform').submit(function() {
      $('#loaders').show();
            $(this).ajaxSubmit(options);
       
         
        return false;
        
    });
    //Ends  
});
</script>
