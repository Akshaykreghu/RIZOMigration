<<script type="text/javascript">
$(document).ready(function() { 
	$("#pincode").inputmask("999");
  $('#bankForm').parsley();
    var options = { 
success:       function(responseText, statusText, xhr, $form){
	closeModal('brtable');
}
    }; 
 
    // bind to the form's submit event 
    $('#bankForm').submit(function() { 
        $(this).ajaxSubmit(options); 
 
        
        return false; 
    });
    }); 
</script>