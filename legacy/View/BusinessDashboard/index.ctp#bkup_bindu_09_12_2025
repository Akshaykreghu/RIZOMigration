<script>
    // Function to load CTC Breakup chart
    function loadCTCBreakup(monthYear) {
        $.ajax({
            url: '<?php echo $this->webroot; ?>BusinessDashboard/getCTCBreakup',
            type: 'GET',
            data: {
                month_year: monthYear
            },
            dataType: 'json',
            success: function(ctcData) {
                $('#ctc-breakup-title').text(`CTC Breakup - Components (${ctcData.month_name || ''})`);

                // Format data for Morris Donut
                const donutData = [{
                        label: "Fixed Monthly Components",
                        value: Math.abs(parseFloat(ctcData.fixed_salary || 0))
                    },
                    {
                        label: "Variable Components",
                        value: parseFloat(ctcData.variable_salary || 0)
                    },
                    {
                        label: "Employer Contributions",
                        value: Math.abs(parseFloat(ctcData.employer_contribution || 0))
                    }
                ];

                // Clear and redraw chart
                $('#ctc-pie-chart').empty();
                new Morris.Donut({
                    element: 'ctc-pie-chart',
                    data: donutData,
                    colors: ['#59a14f', '#f28e2b', '#4e79a7'],
                    resize: false,
                    formatter: function(value) {
                        return '₹' + value.toLocaleString();
                    }
                });

                // Update table
                const colors = ['#59a14f', '#f28e2b', '#4e79a7'];
                const tableBody = $('#ctc-color-table tbody');
                tableBody.empty();

                let total = 0;
                donutData.forEach((d, i) => {
                    const row = `
                        <tr>
                            <td><span style="display:inline-block;width:20px;height:20px;background:${colors[i]};border-radius:3px;"></span></td>
                            <td>${d.label}</td>
                            <td>₹${d.value.toLocaleString()}</td>
                        </tr>`;
                    total += d.value;
                    tableBody.append(row);
                });

                // ✅ Add Total row at bottom
                tableBody.append(`
                    <tr style="font-weight:bold; background:#f8f9fa;">
                        <td colspan="2" style="text-align:right;">Total:</td>
                        <td>₹${total.toLocaleString()}</td>
