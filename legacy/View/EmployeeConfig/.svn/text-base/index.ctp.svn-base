var allempsforstruct;

var allempsforholiday;
var empsinholiday;


			
function doOnEMPSelect(id)
{
	
	emplist1.clearAndLoad("<?php echo $this->webroot; ?>EmployeeHierarchy/listemployeesforhierarchy?parentEmpKey="+id,"json");

	emplist2.clearAndLoad("<?php echo $this->webroot; ?>EmployeeHierarchy/listchildEmployee?parentEmpKey="+id,"json");
			
}

			
			
			allempsforstruct = new dhtmlXGridObject('empstructbox');
			allempsforstruct.setHeader("Employees");
			allempsforstruct.setColAlign("left");
			allempsforstruct.setColumnIds("name");	
			allempsforstruct.setInitWidthsP("100");
			allempsforstruct.attachHeader("#text_search");
			//myGrid.enableAutoHeight(true,400);
			allempsforstruct.attachEvent("onRowSelect",doOnEMPSelect);
			allempsforstruct.enableAutoWidth(true);
			allempsforstruct.setColTypes("ro");
			allempsforstruct.init();
			allempsforstruct.load("<?php echo $this->webroot; ?>EmployeeHierarchy/listemployees","json");
			
			
			
			
						emplist1 = new dhtmlXGridObject('emplist1');
						emplist1.selMultiRows = true;
						emplist1.setHeader("Name,Branch");
						emplist1.setInitWidths("100,150");
						emplist1.setColAlign("left,left");
					//	allempsforsp.attachHeader("#text_search,#combo_filter");
						emplist1.setColSorting("str,str");
						emplist1.attachEvent("onDrag", function(sId,tId,sObj,tObj,sInd,tInd){
											  if(allempsforstruct.getSelectedRowId()){
							$.ajax({	
																						 url:  livesite+"EmployeeHierarchy/remove",
																						 data: {
																							 id : sId,
																							parent : allempsforstruct.getSelectedRowId()
																						 },
																						 success: function(response){
																							 //var text = response.responseText;
																							 // process server response here
																							
																										$.notify("Employee Hierarchy Updated",{
																												type: 'success',
																												allow_dismiss: false
																												
																											});
																						 }
																					 });
																					}
																					return true;
						});
						emplist1.setMultiLine(false);
						emplist1.enableDragAndDrop(true);
						emplist1.init();
						//
					    emplist2 = new dhtmlXGridObject('emplist2');
						emplist2.selMultiRows = true;
						emplist2.setHeader("Name,Branch");
						emplist2.setInitWidths("100,150");
						emplist2.setColAlign("left,left");
					//	allempsforsp.attachHeader("#text_search,#combo_filter");
						emplist2.setColSorting("str,str");
						emplist2.attachEvent("onDrag", function(sId,tId,sObj,tObj,sInd,tInd){
											  if(allempsforstruct.getSelectedRowId()){
							$.ajax({	
																						 url:  livesite+"EmployeeHierarchy/add",
																						 data: {
																							 id : sId,
																							 parent : allempsforstruct.getSelectedRowId()
																						 },
																						 success: function(response){
																							 //var text = response.responseText;
																							 // process server response here
																							
																										$.notify("Employee Hierarchy Updated",{
																												type: 'success',
																												allow_dismiss: false
																												
																											});
																						 }
																					 });
																					}
																						return true;
						});
						emplist2.setMultiLine(false);
						emplist2.enableDragAndDrop(true);
						emplist2.init();	
			
			
				
</script>