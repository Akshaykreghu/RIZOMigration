    function findextingsalary() {
        //  alert('hi');
        var aff_date = $('#affected_date').val();
        var emp_id = $('#emp_id').val();
        // alert(emp_id);
        //alert(month);
        var url = '<?php echo $this->webroot; ?>EmployeeExpenses/salarycheck';
//value passiing ajax   
        $.ajax({
            // alert('hi');
            url: url,
            type: 'post',
            data: {
                date: aff_date,
                emp_id: emp_id,
//                     //   active:active
            },
//success time hide                     
            success: function (resp) {
                //alert(resp);
                var json_obj = $.parseJSON(resp);

                if (json_obj.rows.length > 0) {
                    $.notify(json_obj.msg, {
                        type: 'danger',
                        allow_dismiss: false,
                        z_index: '1400'
                    });
//                    alert(json_obj.msg);
                    $("#btn-submit").hide();
                    $("#check").val(1);
                    //$("#btn-submit").hide();
                    //$('#btn-submit').attr(hide);
                    $("#expenses_amount").val('');
                    $('#expenses_amount').attr('readonly', true);
                    $("#remarks").val('');
                    $('#remarks').attr('readonly', true);
                    $('#expense_type').attr('readonly', true);
                    $('#expense_type').val('');
                    $('#image').attr('readonly', true);
                    $('#image').val('');
                    $('#purpose').attr('readonly', true);
                    $('#purpose').val('');
                    $('#vendor').attr('readonly', true);
                    $('#vendor').val('');
                    $('#apr_emp_id').attr('readonly', true);
                    $('#apr_emp_id').val('');
                }
//unhide                  
                else {
                    // $.notify("BOOM!", "error");
                    $("#btn-submit").show();
                    $("#btn-submit").prop("disabled", false);
                    $("#check").val(0);
                    //$("#expenses_amount").val('');
                    $('#expenses_amount').attr('readonly', false);
                    $('#remarks').attr('readonly', false);
                    $('#expense_type').attr('readonly', false);
                    $('#image').attr('readonly', false);
                    $('#purpose').attr('readonly', false);
                    $('#vendor').attr('readonly', false);
                    $('#apr_emp_id').attr('readonly', false);
                }
            }
        });
    }
//validation form amount
    function findamount() {
        var rate = $('#expenses_amount').val();
//number format
        ///^[1-9][0-9\.]{0,15}$/
        ///^\d+$/
        if (rate.match(/^[1-9][0-9\.]{0,15}$/)) {
            if (rate < 1)
            {
                alert('Please Enter A Valid Amount')
                $("#expenses_amount").val('');
            }
        }
        else {
            $("#expenses_amount").val('');
            // alert('hi');
        }

    }

