    function checkdate() {
        var value = $('#expenses_amount').val();
        if (value < 1) {
            //alert('please enter a valid number');
            $('#expenses_amount').val('');
        }
    }
//salary  slip check    
    function findextingsalary() {
      //  alert('hi');
        var aff_date = $('#affected_date').val();
        var emp_id = $('#emp_id').val();
        // alert(emp_id);
        //alert(month);
        var url = 'EmployeeExpenses/salarycheck';
//value passiing ajax   
        $.ajax({
           // alert('hi');
            url: url,
            type: 'post',
            data: {
                date: aff_date,
                emp_id: emp_id,
//                     //   active:active
            },
//success time hide                     
            success: function (resp) {
                //alert(resp);
                var json_obj = $.parseJSON(resp);

                if (json_obj.rows.length > 0) {
                    $.notify(json_obj.msg,{  
                        type: 'danger',
                        allow_dismiss: false
                    });
                     $("#btn-submit").hide();
                     //$("#btn-submit").hide();
                    //$('#btn-submit').attr(hide);
                    $("#expenses_amount").val('');
                    $('#expenses_amount').attr('readonly', true);
                    $("#remarks").val('');
                    $('#remarks').attr('readonly', true);

                }
//unhide                  
                else {
                   // $.notify("BOOM!", "error");
                    $("#btn-submit").show();
                    //$("#expenses_amount").val('');
                    $('#expenses_amount').attr('readonly', false);
                    $('#remarks').attr('readonly', false);
                }
            }
        });
    }
