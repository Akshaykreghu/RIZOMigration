<script>
    $(document).ready(function() {
        $('#processButton').on('click', function() {
            var $btn = $(this);
            $btn.prop('disabled', true).text('Processing...');
            var salary_hike_pkey = $(this).data('salary-hike-pkey');
            var is_item = $(this).data('is-item');
            var is_multiple = $(this).data('is-multiple');
            var structure_change = $(this).data('structure-change');

            function callProcess() {
                $.ajax({
                    url: livesite + (is_item === 'Y' ? 'SalaryIncrement/processItem' : 'SalaryIncrement/process'),
                    type: 'POST',
                    data: {
                        salary_hike_pkey: salary_hike_pkey,
                        is_multiple: is_multiple
                    },
                    success: function(response) {
                        var result;
                        try {
                            result = JSON.parse(response);
                        } catch (e) {
                            $.notify('Invalid server response', {
                                type: 'danger',
                                z_index: 9999
                            });
                            return;
                        }

                        if (result.success) {
                            $.notify('Processed successfully', {
                                type: 'success',
                                z_index: 9999
                            });

                        } else {
                            $.notify(result.message || 'Processing failed', {
                                type: 'danger',
                                z_index: 9999
                            });
                        }

                        $('#att_table').datagrid('reload');
                        $('.modal').modal('hide');

                        // Edited by Akshay on 30-10-2025
                        if (result.error_message && result.error_message != '') {
                            $.notify(result.error_message, {
                                type: 'danger',
                                z_index: 9999
                            });
                        }
                        // End
                    },
                    error: function() {
                        $.notify('Server error occurred', {
                            type: 'danger',
                            z_index: 9999
                        });
                    }
                });
            }

            if (structure_change === 'Y') {
                $.ajax({
                    url: livesite + 'SalaryIncrement/alterSalaryStructure',
                    type: 'POST',
                    data: {
                        salary_hike_pkey: salary_hike_pkey
                    },
                    success: function(response) {
                        var result;
                        try {
                            result = JSON.parse(response);
                        } catch (e) {
                            $.notify('Invalid structure response', {
                                type: 'danger',
                                z_index: 9999
                            });
                            return;
                        }

                        if (result.success) {
                            callProcess();
                        } else {
                            $.notify(result.message || 'Failed to update structure.', {
                                type: 'danger',
                                z_index: 9999
                            });
                            callProcess();
                        }
                    },
                    error: function() {
                        $.notify('Error while updating structure', {
                            type: 'danger',
                            z_index: 9999
                        });
                    }
                });
            } else {
                callProcess(); // Directly process if no structure change
            }
        });


        // Download button
        $('#downloadButton').on('click', function() {
            var salary_hike_pkey = $(this).data('salary-hike-pkey');
            var is_item = $(this).data('is-item'); // 'Y' or 'N'
            var is_multiple = $(this).data('is-multiple'); // 'Y' or 'N'

            var url = livesite + (is_item === 'Y' ? 'SalaryIncrement/itemIncerementReport' : 'SalaryIncrement/incerementReport');

            // Create a temporary form
            var form = $('<form>', {
                method: 'POST',
                action: url,
                target: '_blank'
            });

            // Add hidden inputs
            form.append($('<input>', {
                type: 'hidden',
                name: 'salary_hike_pkey',
                value: salary_hike_pkey
            }));

            form.append($('<input>', {
                type: 'hidden',
                name: 'is_multiple',
                value: is_multiple
            }));

            // Append form, submit, then remove it
            $('body').append(form);
            form.submit();
            form.remove();
        });

        // Delete button
        $('#deleteButton').on('click', function() {
            var salary_hike_pkey = $(this).data('salary-hike-pkey');

            if (!confirm("Are you sure you want to delete this increment record?")) return;

            $.ajax({
                url: livesite + 'SalaryIncrement/deleteIncrement', // <-- Adjust this path if needed
                type: 'POST',
                data: {
                    salary_hike_pkey: salary_hike_pkey
                },
                success: function(response) {
                    var result;
                    try {
                        result = JSON.parse(response);
                    } catch (e) {
                        $.notify('Invalid response from server', {
                            type: 'danger',
                            z_index: 9999
                        });
                        return;
                    }

                    if (result.success) {
                        $.notify(result.message || 'Deleted successfully', {
                            type: 'success',
                            z_index: 9999
                        });
                        $('#att_table').datagrid('reload');
                        $('.modal').modal('hide');
                    } else {
                        $.notify(result.message || 'Failed to delete record', {
                            type: 'danger',
                            z_index: 9999
                        });
                    }
                },
                error: function() {
                    $.notify('Server error occurred during delete', {
                        type: 'danger',
                        z_index: 9999
                    });
                }
            });
        });

    });
</script>