                    //                        op_msg+="Employee :"+response.duplication_issue.data[i]['name']+", Date:"+response.duplication_issue.data[i]['date']+"\n";
                    //                    }
                    //                }
                    //                if(response.month_issue.success==0){
                    //                    op_msg+="\n"+response.month_issue.msg+"\n";
                    //                    for(var i=0;i<response.month_issue.data.length;i++){
                    //                        op_msg+="Employee :"+response.month_issue.data[i]['name']+", Date:"+response.month_issue.data[i]['date']+"\n";
