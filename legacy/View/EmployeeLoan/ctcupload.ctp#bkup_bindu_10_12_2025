            url: url,
            type: 'post',
            data: {
                //   menu_id : menu_id,
                //   user_pkey:user_pkey,
                //   active:active
            },
            success: function(response) {
                var resp = JSON.parse(response);
                if (resp.success) {
                    $('#attdatacsv').val("");
                    //                if ($.parseJSON(resp).msg) {
                    if (resp.success == 1) {
                        $.notify(resp.msg, {
                            type: 'success',
                            allow_dismiss: false
                        });
                    }
                }
                if (resp.success == 0) {
                    //below code is to check wether the start month is less than current month. By ARUL P DAS on 19/11/2019
                    if (resp.error == 'error') {
                        $.notify(resp.msg, {
                            type: 'danger',
                            allow_dismiss: false
                        });
                        // $('#att_table').datagrid('reload');
                    }
                }
                $('#att_table').datagrid('reload');
