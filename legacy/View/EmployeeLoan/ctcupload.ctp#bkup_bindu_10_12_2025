                    //                    type: 'error',
                    //                    allow_dismiss: false
                    //                });
                    ///////////THE BELOW CODE IS TO CHECK THE LOAN DATE,DUPLICATE ENTRY AND SALARY PREOCESSED OR NOT.///////////////////
                    //////////By ***ARUL P DAS on 2/1/2020
                    var op_msg = "";
                    //                if(response.duplication_issue.success==0){
                    //                    op_msg+="Duplicate entries found.\n";
