<script>
    jQuery(document).ready(function () {        
        $('.tabset-approvepayroll').pwstabs({
            effect: 'scale', // You can change effects of your tabs container: scale / slideleft / slideright / slidetop / slidedown / none
            defaultTab: 1, // The tab we want to be opened by default
            containerWidth: '100%', // Set custom container width if not set then 100% is used
            tabsPosition: 'horizontal', // Tabs position: horizontal / vertical
            horizontalPosition: 'top', // Tabs horizontal position: top / bottom
            verticalPosition: 'left', // Tabs vertical position: left / right
            responsive: true, // Make tabs container responsive: true / false - boolean
            theme: '',
            rtl: false                    // Right to left support: true/ false
        });
        $('.tabset-approvepayroll #tab1').load(livesite + "payroll/showapprovepayrolltab/0");
        //$('.tabset-approvepayroll #tab2').load(livesite + "payroll/showapprovepayrolltab/1");
    });
	
	jQuery('#div-showapprovepayroll .pws_tabs_controll a').on('click', function(){
		var tabIndex = $(this).data('tabId');
		if(tabIndex == "tab1"){
			$('.tabset-approvepayroll #tab1').load(livesite + "payroll/showapprovepayrolltab/0");
		}else{
			$('.tabset-approvepayroll #tab2').load(livesite + "payroll/showapprovepayrolltab/1");
		}
	});
    
    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun","Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    function filterPayroll() {
        
        var month = $('#approvepayrollfilter #filterby_month').val();
        var branch = $('#approvepayrollfilter #filterby_branch').val();
        
        var dt = new Date(month);
        $('#current_register_month').html(monthNames[dt.getMonth()]+'-'+dt.getFullYear());
        
        $('.tabset-approvepayroll #tab1').load(livesite + "payroll/showapprovepayrolltab/0",{month:month,branch:branch});
        $('.tabset-approvepayroll #tab2').load(livesite + "payroll/showapprovepayrolltab/1",{month:month,branch:branch});
        $('#approvepayrolltable').datagrid('load');  
        
    }

    function approvePayroll() {
        var branch = $('#approvepayrollfilter #filterby_branch').val();
        var month = $('#approvepayrollfilter #filterby_month').val();
        
        var arr_payroll_pkeys = [];
        var checkedRows = $('#approvepayrolltable').datagrid('getChecked');
        for (var register in checkedRows) {
            arr_payroll_pkeys.push(checkedRows[register]['payroll_master_pkey']);
        }
        $.ajax({
            url: livesite + "payroll/approvepayroll",
            type: 'post',
            data: {
                payroll_pkey: arr_payroll_pkeys.join(',')
            },
            success: function (response) {
                //process server response here
                var success = $.parseJSON(response).success;
                if (success) {
                    $.notify("Payroll approved successfully", {
                        type: 'success',
                        allow_dismiss: false
                    });
                    $('#approvepayrolltable').datagrid('load', {
                        branch: branch,
                        month: month
                    });
                    $('#approvedpayrolltable').datagrid('load', {
                        branch: branch,
                        month: month
                    });
                } else {
                    //alert('Attendance process failed!');
                    $.notify("Payroll approve failed!", {
                        type: 'danger',
                        allow_dismiss: false
                    });
                }
            }
        });
    }
</script>